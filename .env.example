# Copy to .env and adjust if needed. These are local-only dev defaults —
# MinIO's own published default credentials and a throwaway Postgres user,
# not real AWS credentials. They only work against the Docker Compose
# network on your machine.
#
# docker-compose.yml falls back to these same values if .env is absent,
# so `docker compose up` works out of the box without this step.

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Postgres (Iceberg JDBC catalog)
ICEBERG_CATALOG_DB=iceberg_catalog
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=iceberg

# AWS SDK credentials, pointed at the local MinIO endpoint (not real AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
